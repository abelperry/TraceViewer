# Trace Review 服务端环境变量示例。
# 复制为 .env 后按需修改；.env 已被 git 忽略，本文件仅作说明。
# 未配置的变量会回退到下面注释里的默认值。
#
# 注意：.env 里的**非空值优先于 shell 环境变量**（与 node --env-file 相反）。
# 因为使用者常已为「自己的 Claude Code」导出 ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN，
# 若让环境变量优先，这里的配置会被静默劫持。留空 = 不覆盖。

# 后端端口
PORT=4000

# Claude Code trace 扫描根目录（默认 ~/.claude/projects）
CLAUDE_PROJECTS_DIR=

# Codex trace 扫描根目录（默认 ~/.codex）
CODEX_SESSIONS_DIR=

# 元数据 + 日用量 + 评审索引 数据库路径
DB_PATH=./trace-review.sqlite

# ---- LLM trace 评审（可选）----
# 配置任一凭据即启用评审；两者都留空 = 评审关闭（例行空跑、手动触发返回 409）。

# 代理网关鉴权令牌 → 以 Authorization: Bearer <token> 发送
ANTHROPIC_AUTH_TOKEN=

# 官方 API Key → 以 x-api-key 发送（与 AUTH_TOKEN 二选一）
ANTHROPIC_API_KEY=

# 自定义 / 中转端点；留空用官方默认 https://api.anthropic.com
ANTHROPIC_BASE_URL=

# 评审所用模型（留空默认 claude-opus-5）
REVIEW_MODEL=claude-opus-5
