{
  "name": "trace-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @trace-review/server --filter @trace-review/web dev",
    "dev:server": "pnpm --filter @trace-review/server dev",
    "dev:web": "pnpm --filter @trace-review/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
